DATABASE_URL=postgresql://saberent:CHANGE_ME@127.0.0.1:5432/saberent
ARC_RPC_URL=http://127.0.0.1:8545
# Optional comma-separated standby primaries, tried in order when ARC_RPC_URL is
# unreachable. Availability only: a provider returning inconsistent data still
# fails closed instead of moving on. Must not repeat the witness endpoint.
# ARC_RPC_FALLBACK_URLS=https://second-provider.example,https://third-provider.example
# Optional independent witness. Different provider / failure domain recommended.
# Never list this URL as a primary; it would then confirm its own answers.
# ARC_WITNESS_RPC_URL=https://your-independent-arc-testnet-rpc
SABERENT_MANIFEST=/absolute/path/to/deployments/arc-testnet.operator.json
PORT=8788

# Bounded header concurrency (1–16) and finalized blocks per pass (1–500).
# A single range log query per vault avoids one log request per block.
INDEX_BATCH_SIZE=100
INDEX_CONCURRENCY=4
