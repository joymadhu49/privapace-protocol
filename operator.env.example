# Copy to operator.env next to compose.yaml. DATABASE_URL is set by compose.
# Primary Arc testnet RPC. Use your own provider if you have one.
ARC_RPC_URL=https://rpc.testnet.arc.io
# Optional standby primaries, tried in order only when the primary is unreachable.
# ARC_RPC_FALLBACK_URLS=https://another-provider.example
# Strongly recommended: an independent witness on a different provider.
# It cross-checks finalized heads and must not also be listed as a primary.
# ARC_WITNESS_RPC_URL=https://rpc.blockdaemon.testnet.arc.io
INDEX_BATCH_SIZE=100
INDEX_CONCURRENCY=4
